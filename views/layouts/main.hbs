<!DOCTYPE html>
<html lang="en">
  <head>
    <base href="./">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <meta name="description" content="Course Management System - INFS3201 Project">
    <meta name="author" content="Your Team">
    <meta name="keyword" content="Course,Management,System,INFS3201">
    <title>{{title}} - Course Management System</title>
    <!-- CoreUI Styles -->
    <link rel="stylesheet" href="/vendors/simplebar/css/simplebar.css">
    <link rel="stylesheet" href="/css/vendors/simplebar.css">
    <link href="/css/style.css" rel="stylesheet">
    <!-- Custom Styles -->
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    {{#if fullPageLayout}}
    <!-- Full-page layout for login, register, error, etc. -->
    <div class="bg-light min-vh-100 d-flex flex-row align-items-center">
      <div class="container">
        {{{body}}}
      </div>
    </div>
    {{else}}
    <!-- Dashboard layout with sidebar -->
    <div class="sidebar sidebar-dark sidebar-fixed" id="sidebar">
      <div class="sidebar-brand d-none d-md-flex">
        <span class="fw-semibold">Course Management</span>
      </div>
      <ul class="sidebar-nav" data-coreui="navigation" data-simplebar="">
        {{#if user}}
        {{#if (eq user.role 'student')}}
        <li class="nav-item"><a class="nav-link {{#if (eq title 'Student Dashboard')}}active{{/if}}" href="/student-dashboard">Dashboard</a></li>
        {{/if}}
        {{#if (eq user.role 'department_head')}}
        <li class="nav-item"><a class="nav-link {{#if (eq title 'Admin Dashboard')}}active{{/if}}" href="/admin-dashboard?name={{user.name}}">Dashboard</a></li>
        {{/if}}
        <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
        {{/if}}
      </ul>
      <button class="sidebar-toggler" type="button" data-coreui-toggle="unfoldable">Toggle Sidebar</button>
    </div>
    <div class="wrapper d-flex flex-column min-vh-100 bg-light">
      <div class="body flex-grow-1 px-3">
        <div class="container-lg">
          {{{body}}}
        </div>
      </div>
      <footer class="footer">
        <div><a href="https://coreui.io">CoreUI</a> © 2023 creativeLabs.</div>
        <div class="ms-auto">Powered by <a href="https://coreui.io/docs/">CoreUI UI Components</a></div>
      </footer>
    </div>
    {{/if}}
    <!-- CoreUI Scripts -->
    <script src="/vendors/@coreui/coreui/js/coreui.bundle.min.js"></script>
    <script src="/vendors/simplebar/js/simplebar.min.js"></script>
    <!-- Custom Script for Random Request Button -->
    <script>
      document.getElementById('random-request')?.addEventListener('click', async () => {
        const response = await fetch('/admin/random-request');
        if (response.ok) {
          const data = await response.json();
          if (data.id) {
            window.location.href = `/admin/request/${data.id}`;
          } else {
            alert('No pending requests available.');
          }
        } else {
          alert('Error fetching random request.');
        }
      });
    </script>
  </body>
</html>