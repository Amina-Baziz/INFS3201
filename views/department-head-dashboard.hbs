<div class="card mb-4">
  <div class="card-header">
    <strong>Department Head Dashboard</strong>
  </div>
  <div class="card-body">
    <div class="mb-3">
      <p class="fw-semibold">Welcome, Admin {{name}}!</p>
      <p class="text-medium-emphasis">This is the admin panel where you can manage student requests.</p>
    </div>
    <h4 class="card-title mb-0">Queues</h4>
    {{#if queues.length}}
      {{#each queues}}
      <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
          <h5 class="mb-0">{{this.category}} ({{this.count}} requests)</h5>
          <a href="/admin/queue/{{this.category}}" class="btn btn-primary px-3">View Queue</a>
        </div>
      </div>
      {{/each}}
    {{else}}
      <p class="text-medium-emphasis">No pending requests at this time.</p>
    {{/if}}
    <a href="/admin/random-request" class="btn btn-warning px-4 mt-3">I don't know where to begin!</a>
  </div>
</div>