<div class="row">
  <div class="col">
    <h1 class="display-3">Student Dashboard</h1>
    <p class="text-medium-emphasis">Welcome, {{user.name}}!</p>
    <div class="card mb-3">
      <div class="card-header">
        <h4>My Requests</h4>
      </div>
      <div class="card-body">

      <form method="GET" action="/student-dashboard" class="mb-3">
        <label for="semester">Filter by Semester:</label>
        <select name="semester" id="semester" class="form-select" onchange="this.form.submit()">
          <option value="all" {{#unless selectedSemester}}selected{{/unless}}>All Semesters</option>
          {{#each semesters}}
            <option value="{{this}}" {{#if (eq ../selectedSemester this)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </form>



        {{#if requests.length}}
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>#</th>
                <th>Category</th>
                <th>Note</th>
                <th>Semester</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#each requests}}
              <tr>
                <td>{{@index}}</td>
                <td>{{this.category}}</td>
                <td>{{this.note}}</td>
                <td>{{this.semester}}</td>
                <td>{{this.status}}</td>
                <td>
                  <a href="/student/request/{{this._id}}" class="btn btn-primary">View</a>
                  {{#if (eq this.status "pending")}}
                  <form action="/request/cancel/{{this._id}}" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-danger btn-sm ms-2">Cancel</button>
                  </form>
                  {{/if}}
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <p>No requests found.</p>
        {{/if}}
        <a href="/request/new" class="btn btn-primary mt-3">Submit New Request</a>
      </div>
    </div>
  </div>
</div>