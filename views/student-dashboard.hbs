<h1>Student Dashboard</h1>
<h2>Your Requests</h2>
<table>
    <thead>
        <tr>
            <th>Request ID</th>
            <th>Category</th>
            <th>Status</th>
            <th>Submitted At</th>
            <th>Estimated Completion</th>
        </tr>
    </thead>
    <tbody>
        {{#each requests}}
        <tr>
            <td>{{this.id}}</td>
            <td>{{this.category}}</td>
            <td>{{this.status}}</td>
            <td>{{this.submittedAt}}</td>
            <td>{{this.estimatedCompletion}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>
<a href="/request/new" class="btn">Submit New Request</a>